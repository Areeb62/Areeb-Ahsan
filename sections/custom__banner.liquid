{% style %}
    #Banner-{{ section.id }} {
      padding-top: {{ section.settings.spacing_top }}px;
      padding-bottom: {{ section.settings.spacing_bottom }}px;
    }

    .banner-top-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 40px;
  }

  .banner-image {
      position: relative;
  }

  .banner-content--wrapper {
      position: absolute;
      top:0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        padding: 40px;
  }

  .banner-bottom-content {
    padding: 8px 40px;
    text-align: center;
}




    @media screen and (max-width: 749px) {
     #Banner-{{ section.id }} {
          padding-top: {{ section.settings.spacing_top_mb }}px;
          padding-bottom: {{ section.settings.spacing_bottom_mb }}px;
      }
    }
{% endstyle %}

{% liquid
  assign top_content = false
  if section.settings.logo != blank or section.settings.announcement != blank or section.settings.button_text != blank
    assign top_content = true
  endif
%}

<div id="Banner-{{ section.id }}" class="banner-container">
  {% if top_content %}
    <div class="banner-top-content">
      {% if section.settings.logo != blank %}
        <div class="banner-top--logo">
          {{ section.settings.logo | image_url: width: 150 | image_tag }}
        </div>
      {% endif %}
      {% if section.settings.announcement != blank %}
        <div class="banner-top--announcement">
          <p>
            {{ section.settings.announcement }}
          </p>
        </div>
      {% endif %}
      {% if section.settings.button_text != blank %}
        <div class="banner-top--button">
          {% render 'custom-button',
            url: section.settings.button_url,
            button_text: section.settings.button_text,
            styletype: section.settings.button_style
          %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="banner-image">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 4100 | image_tag }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="banner-content--wrapper">
        <article class="banner-content">
          {% for block in section.blocks %}
            <div id="block-{{ block.id }}" class="block--{{ block.type }}">
              {% case block.type %}
                {% when 'preheading' %}
                  <p class="preheading" {{ block.shopify_attributes }}>{{ block.settings.preheading }}</p>
                {% when 'heading' %}
                  <h2 class="heading" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h2>

                {% when 'description' %}
                  <div id="block--{{ block.type }}" class="description" {{ block.shopify_attributes }}>
                    {{ block.settings.description }}
                  </div>

                {% when 'button' %}
                  <div id="block--{{ block.type }}" class="banner-button" {{ block.shopify_attributes }}>
                    {% render 'custom-button',
                      url: block.settings.button_url,
                      button_text: block.settings.button_text,
                      styletype: block.settings.button_style
                    %}
                  </div>
              {% endcase %}
            </div>
          {% endfor %}
        </article>
      </div>
    {% endif %}
  </div>

  {% if section.settings.media_caption != blank %}
    <div class="banner-bottom-content">
      <p>
        {{ section.settings.media_caption }}
      </p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Banner",
  "class": "section-banner",
  "tag": "section",
  "blocks": [
    {
      "type": "preheading",
      "name": "Preheading",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "preheading",
          "label": "Preheading",
          "default": "Preheading"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Title"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Text",
          "default": "<p>Description</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ]
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "inline_richtext",
      "id": "announcement",
      "label": "Announcement text",
      "default": "Announcement"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "media_caption",
      "label": "Media caption",
      "default": "Caption"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Deskop spacing"
    },
    {
      "type": "number",
      "id": "spacing_top",
      "label": "Spacing top (px)",
      "default": 50
    },
    {
      "type": "number",
      "id": "spacing_bottom",
      "label": "Spacing bottom (px)",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "number",
      "id": "spacing_top_mb",
      "label": "Spacing top (px)",
      "default": 30
    },
    {
      "type": "number",
      "id": "spacing_bottom_mb",
      "label": "Spacing bottom (px)",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
