{%- comment -%}
  Product grid with hotspots — custom built (no Dawn components, classes or snippets).
  Figma: "Test for Candidates" → "Tisso vison in the wild" (desktop 1440 / mobile 375)
  and the quick view overlay (Frame 1000009755).
{%- endcomment -%}

{%- liquid
  assign body_font = section.settings.body_font
  assign body_font_light = body_font | font_modify: 'weight', '300'

  assign columns_desktop = section.settings.columns_desktop | at_least: 1
  assign columns_mobile = section.settings.columns_mobile | plus: 0 | at_least: 1
  assign desktop_gaps = columns_desktop | minus: 1 | times: 20
  assign desktop_offset = desktop_gaps | plus: 100
  assign desktop_max = 1339 | minus: desktop_gaps | divided_by: columns_desktop
  assign mobile_offset = columns_mobile | minus: 1 | times: 4 | plus: 32
  assign image_sizes = '(min-width: 1440px) ' | append: desktop_max | append: 'px, (min-width: 750px) calc((100vw - ' | append: desktop_offset | append: 'px) / ' | append: columns_desktop | append: '), calc((100vw - ' | append: mobile_offset | append: 'px) / ' | append: columns_mobile | append: ')'
-%}

{%- comment -%} Lustria is not in Shopify's font library, so it loads from Google Fonts {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lustria&display=swap" rel="stylesheet">

{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}

{%- comment -%} Only setting-driven CSS lives here; static styles are in assets/custom-product-grid.css {%- endcomment -%}
{% style %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_light -%}
    {{ body_font_light | font_face: font_display: 'swap' }}
  {%- endif -%}

  #ProductGrid-{{ section.id }} {
    --pg-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --pg-columns: {{ section.settings.columns_desktop }};
    --pg-columns-mobile: {{ section.settings.columns_mobile }};
    padding-top: {{ section.settings.spacing_top }}px;
    padding-bottom: {{ section.settings.spacing_bottom }}px;
  }

  {%- for block in section.blocks %}
  #Hotspot-{{ block.id }} {
    left: {{ block.settings.position_x }}%;
    top: {{ block.settings.position_y }}%;
  }
  {%- endfor %}

  @media screen and (max-width: 749px) {
    #ProductGrid-{{ section.id }} {
      padding-top: {{ section.settings.spacing_top_mb }}px;
      padding-bottom: {{ section.settings.spacing_bottom_mb }}px;
    }
  }
{% endstyle %}

<div id="ProductGrid-{{ section.id }}" class="pg-section">
  <div class="pg">
    {%- if section.settings.heading != blank or section.settings.button_text != blank -%}
      <div class="pg__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="pg__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <div class="pg__button">
            {% render 'custom-button',
              url: section.settings.button_url,
              button_text: section.settings.button_text,
              styletype: section.settings.button_style
            %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="pg__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <li class="pg-card" {{ block.shopify_attributes }}>
          {%- liquid
            if block.settings.image != blank
              assign card_image = block.settings.image
            elsif product.featured_image
              assign card_image = product.featured_image
            else
              assign card_image = nil
            endif
          -%}

          {%- if card_image -%}
            {{
              card_image
              | image_url: width: 1300
              | image_tag:
                class: 'pg-card__img',
                loading: 'lazy',
                sizes: image_sizes,
                widths: '340, 450, 680, 900, 1300',
                alt: product.title
            }}
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {{ 'product-apparel-' | append: placeholder_index | placeholder_svg_tag: 'pg-card__img' }}
          {%- endif -%}

          {%- if product != blank -%}
            <button
              type="button"
              id="Hotspot-{{ block.id }}"
              class="pg-hotspot"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="QuickView-{{ block.id }}"
              aria-label="Quick view: {{ product.title | escape }}"
              data-qv-open="QuickView-{{ block.id }}"
            >
              <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true" focusable="false">
                <path d="M4.5 0V9M0 4.5H9" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </button>

            {% render 'custom-quick-view', product: product, id: block.id %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var CART_URL = {{ routes.cart_url | json }};
    var CART_ADD_URL = {{ routes.cart_add_url | append: '.js' | json }};

    function init() {
      var root = document.getElementById('ProductGrid-' + SECTION_ID);
      if (!root || root.dataset.pgReady === 'true') return;
      root.dataset.pgReady = 'true';

      root.querySelectorAll('[data-qv-open]').forEach(function (trigger) {
        var dialog = document.getElementById(trigger.getAttribute('data-qv-open'));
        if (!dialog) return;

        trigger.addEventListener('click', function () {
          openDialog(dialog, trigger);
        });

        setupDialog(dialog, trigger);
      });
    }

    function openDialog(dialog, trigger) {
      if (dialog.open) return;
      dialog.showModal();
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeDialog(dialog) {
      if (dialog.open) dialog.close();
    }

    function setupDialog(dialog, trigger) {
      var form = dialog.querySelector('[data-qv-form]');
      var idInput = dialog.querySelector('[data-qv-variant-id]');
      var priceEl = dialog.querySelector('[data-qv-price]');
      var errorEl = dialog.querySelector('[data-qv-error]');
      var submit = dialog.querySelector('[data-qv-submit]');
      var submitText = dialog.querySelector('[data-qv-submit-text]');
      var variantsEl = dialog.querySelector('[data-qv-variants]');
      var variants = [];

      try {
        variants = JSON.parse(variantsEl.textContent);
      } catch (e) {}

      dialog.querySelectorAll('[data-qv-close]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          closeDialog(dialog);
        });
      });

      // Close when clicking the backdrop (outside the dialog box)
      dialog.addEventListener('click', function (event) {
        if (event.target !== dialog) return;
        var rect = dialog.getBoundingClientRect();
        var inside =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;
        if (!inside) closeDialog(dialog);
      });

      dialog.addEventListener('close', function () {
        trigger.setAttribute('aria-expanded', 'false');
        hideError();
        trigger.focus();
      });

      function getSelectedOptions() {
        var groups = {};
        dialog.querySelectorAll('[data-option-index]').forEach(function (input) {
          var index = Number(input.getAttribute('data-option-index'));
          if (!(index in groups)) groups[index] = null;
          if (input.tagName === 'SELECT') {
            groups[index] = input.value || null;
          } else if (input.checked) {
            groups[index] = input.value;
          }
        });
        return Object.keys(groups)
          .sort()
          .map(function (key) {
            return groups[key];
          });
      }

      function getMissingOptionName() {
        var missing = null;
        dialog.querySelectorAll('select[data-option-index]').forEach(function (select) {
          if (!missing && !select.value) {
            var label = dialog.querySelector('label[for="' + select.id + '"]');
            missing = label ? label.textContent.trim().toLowerCase() : 'option';
          }
        });
        return missing;
      }

      function findVariant(selected) {
        if (selected.indexOf(null) !== -1) return null;
        for (var i = 0; i < variants.length; i++) {
          var match = variants[i].options.every(function (value, index) {
            return value === selected[index];
          });
          if (match) return variants[i];
        }
        return null;
      }

      function updateVariant() {
        hideError();
        var selected = getSelectedOptions();
        if (!selected.length) return;

        var complete = selected.indexOf(null) === -1;
        var variant = findVariant(selected);

        idInput.value = variant ? variant.id : '';
        if (variant) priceEl.textContent = variant.price;

        if (complete && !variant) {
          setSubmit(false, 'Unavailable');
        } else if (variant && !variant.available) {
          setSubmit(false, 'Sold out');
        } else {
          setSubmit(true, 'Add to cart');
        }
      }

      function setSubmit(enabled, text) {
        submit.disabled = !enabled;
        submitText.textContent = text;
      }

      function showError(message) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      function hideError() {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }

      dialog.addEventListener('change', function (event) {
        if (event.target.hasAttribute('data-option-index')) updateVariant();
      });

      form.addEventListener('submit', function (event) {
        event.preventDefault();

        if (!idInput.value) {
          var missing = getMissingOptionName();
          showError(missing ? 'Please choose your ' + missing + '.' : 'Please select an option.');
          return;
        }

        addToCart(Number(idInput.value));
      });

      function addToCart(variantId) {
        var cartDrawer = document.querySelector('cart-drawer');
        var sections = [];

        if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
          sections = cartDrawer.getSectionsToRender().map(function (section) {
            return section.id;
          });
        }

        submit.setAttribute('aria-busy', 'true');
        submit.disabled = true;
        hideError();

        fetch(CART_ADD_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: 1,
            sections: sections,
            sections_url: window.location.pathname,
          }),
        })
          .then(function (response) {
            return response.json().then(function (data) {
              return { ok: response.ok, data: data };
            });
          })
          .then(function (result) {
            if (!result.ok || result.data.status) {
              showError(result.data.description || result.data.message || 'Could not add to cart.');
              return;
            }

            closeDialog(dialog);

            if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
              cartDrawer.renderContents(result.data);
            } else {
              window.location.href = CART_URL;
            }
          })
          .catch(function () {
            showError('Could not add to cart. Please try again.');
          })
          .finally(function () {
            submit.removeAttribute('aria-busy');
            submit.disabled = false;
          });
      }

      updateVariant();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Theme editor: re-init when this section is re-rendered
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === SECTION_ID) init();
    });

    // Theme editor: open the quick view of the selected block
    document.addEventListener('shopify:block:select', function (event) {
      if (!event.detail || event.detail.sectionId !== SECTION_ID) return;
      var trigger = document.getElementById('Hotspot-' + event.detail.blockId);
      if (trigger) trigger.focus();
    });
  })();
</script>

{% schema %}
{
  "name": "Product grid w/ hotspots",
  "tag": "section",
  "class": "section-product-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "secondary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "jost_n4"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "number",
      "id": "spacing_top",
      "label": "Spacing top (px)",
      "default": 90
    },
    {
      "type": "number",
      "id": "spacing_bottom",
      "label": "Spacing bottom (px)",
      "default": 90
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "number",
      "id": "spacing_top_mb",
      "label": "Spacing top (px)",
      "default": 40
    },
    {
      "type": "number",
      "id": "spacing_bottom_mb",
      "label": "Spacing bottom (px)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Defaults to the product's featured image."
        },
        {
          "type": "header",
          "content": "Hotspot position"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 62
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 56
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product grid with hotspots",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
